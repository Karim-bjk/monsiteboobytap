    "custom_liquid_xGL9yF": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"tm-sec\">\n  <h2 class=\"tm-title\">Approuvé par les femmes qui souffrent de <span class=\"a\">transpiration des seins</span> au quotidien</h2>\n  <div class=\"tm-wrap\">\n    <div class=\"tm-track\" id=\"tmTrack\">\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">Je n'aurais jamais cru laisser un avis.</h3><p class=\"tm-txt\">Je n'aurais jamais cru laisser un avis sur ce genre de produit, mais il est vraiment efficace. Je l'utilise depuis quelques semaines, au travail comme à la salle, même sous un t-shirt classique. Doux, facile à laver, et je me sens beaucoup plus à l'aise.</p><div class=\"tm-who\"><span class=\"tm-ava\">M</span><span class=\"tm-name\">Margaux, Lyon</span></div></div>\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">Enfin un produit qui fonctionne vraiment.</h3><p class=\"tm-txt\">J'ai tout essayé : poudres, lingettes, déodorants… rien n'y faisait. Booby Trap me garde au sec sans me gêner ni faire de volume sous ma brassière de sport. Je le porte tout le temps et je n'y pense même plus.</p><div class=\"tm-who\"><span class=\"tm-ava\">C</span><span class=\"tm-name\">Chloé, Paris</span></div></div>\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">J'ai souri en voyant la pub, puis j'ai testé.</h3><p class=\"tm-txt\">J'ai franchement souri en découvrant le concept, mais la curiosité a été la plus forte. Ce n'est pas un gadget : ça marche vraiment, c'est un souci de moins. Et comme c'est réutilisable, je ne pourrais plus m'en passer.</p><div class=\"tm-who\"><span class=\"tm-ava\">I</span><span class=\"tm-name\">Inès, Bordeaux</span></div></div>\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">Fini les irritations sous la poitrine.</h3><p class=\"tm-txt\">Avec la chaleur, j'avais des rougeurs en permanence sous les seins. Depuis que j'utilise Booby Trap, plus rien. C'est discret, confortable, on l'oublie complètement une fois en place.</p><div class=\"tm-who\"><span class=\"tm-ava\">S</span><span class=\"tm-name\">Sarah, Marseille</span></div></div>\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">Parfait pour le sport.</h3><p class=\"tm-txt\">Je transpire énormément en cours de fitness. Ça reste bien en place et j'ai la poitrine au sec du début à la fin de la séance. Un vrai confort, je recommande à toutes les sportives.</p><div class=\"tm-who\"><span class=\"tm-ava\">L</span><span class=\"tm-name\">Léa, Toulouse</span></div></div>\n      <div class=\"tm-card\"><h3 class=\"tm-ch\">Je le recommande à toutes mes amies.</h3><p class=\"tm-txt\">Simple, efficace, lavable. J'en ai racheté pour en avoir toujours un prêt à l'emploi. Franchement, l'été, ça change le quotidien. Je ne comprends pas qu'on n'y ait pas pensé avant.</p><div class=\"tm-who\"><span class=\"tm-ava\">C</span><span class=\"tm-name\">Camille, Nantes</span></div></div>\n    </div>\n    <div class=\"tm-ctrl\">\n      <button class=\"tm-nav tm-prev\" aria-label=\"Précédent\">‹</button>\n      <div class=\"tm-dots\" id=\"tmDots\"></div>\n      <button class=\"tm-nav tm-next\" aria-label=\"Suivant\">›</button>\n    </div>\n  </div>\n</div>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .tm-sec{--bg:#F0FFDE;--card:#FFFFFF;--accent:#A4D867;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--bg);padding:64px 0 54px;overflow:hidden;}\n  .tm-title{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(26px,3.6vw,40px);color:var(--ink);text-align:center;max-width:900px;margin:0 auto 40px;padding:0 20px;line-height:1.12;}\n  .tm-title .a{color:var(--accent);}\n  .tm-wrap{position:relative;max-width:1200px;margin:0 auto;}\n  .tm-track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 24px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}\n  .tm-track::-webkit-scrollbar{display:none;}\n  .tm-card{flex:0 0 calc(50% - 12px);scroll-snap-align:start;background:var(--card);border:3px solid var(--ink);border-radius:22px;padding:30px 30px 26px;display:flex;flex-direction:column;box-sizing:border-box;}\n  .tm-ch{font-family:'Fraunces',serif;font-weight:900;font-size:20px;color:var(--ink);margin:0 0 14px;line-height:1.2;}\n  .tm-txt{font-family:system-ui,-apple-system,sans-serif;color:#3a3a3a;font-size:15.5px;line-height:1.6;margin:0 0 22px;flex:1;}\n  .tm-who{display:flex;align-items:center;gap:12px;}\n  .tm-ava{width:46px;height:46px;border-radius:50%;border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:900;font-size:18px;color:var(--ink);flex:0 0 auto;}\n  .tm-name{font-family:'Fraunces',serif;font-weight:900;font-size:16px;color:var(--ink);}\n  .tm-ctrl{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:30px;}\n  .tm-nav{width:48px;height:48px;border-radius:50%;background:#fff;border:2px solid var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--ink);font-weight:700;padding-bottom:3px;}\n  .tm-dots{display:flex;gap:8px;}\n  .tm-dot{width:11px;height:11px;border-radius:50%;background:rgba(0,0,0,.25);border:none;cursor:pointer;padding:0;}\n  .tm-dot.on{background:var(--ink);}\n  @media(max-width:760px){.tm-card{flex-basis:86%;padding:24px 22px;}}\n</style>\n<script>\n(function(){\n  var track=document.getElementById('tmTrack'),dots=document.getElementById('tmDots');\n  var prev=document.querySelector('.tm-prev'),next=document.querySelector('.tm-next');\n  var cards=Array.prototype.slice.call(track.children);\n  cards.forEach(function(_,i){var b=document.createElement('button');b.className='tm-dot';b.addEventListener('click',function(){track.scrollTo({left:cards[i].offsetLeft-track.children[0].offsetLeft,behavior:'smooth'});});dots.appendChild(b);});\n  function gap(){var st=getComputedStyle(track);return parseFloat(st.columnGap||st.gap||24)||24;}\n  function active(){var l=track.scrollLeft,best=0,bd=1e9;cards.forEach(function(c,i){var d=Math.abs(c.offsetLeft-track.children[0].offsetLeft-l);if(d<bd){bd=d;best=i;}});Array.prototype.forEach.call(dots.children,function(d,i){d.classList.toggle('on',i===best);});}\n  function step(){return track.children[0].offsetWidth+gap();}\n  prev.addEventListener('click',function(){track.scrollBy({left:-step(),behavior:'smooth'});});\n  next.addEventListener('click',function(){track.scrollBy({left:step(),behavior:'smooth'});});\n  var raf;track.addEventListener('scroll',function(){if(raf)cancelAnimationFrame(raf);raf=requestAnimationFrame(active);});\n  active();\n})();\n</script>",
