        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"rs-sec\">\n  <div class=\"rs-grid\">\n    <div class=\"rs-text\">\n      <h2 class=\"rs-title\">Une solution révolutionnaire <span class=\"a\">pour gérer la transpiration des seins.</span></h2>\n      <p class=\"rs-desc\">Conçu dans un tissu antimicrobien haut de gamme qui évacue l'humidité, doublé d'une mousse ultra-absorbante, Booby Trap se glisse discrètement dans votre soutien-gorge et gère la transpiration mieux que n'importe quel autre produit du marché.</p>\n      <div class=\"rs-feats\">\n        <div class=\"rs-feat\">\n          <span class=\"rs-ic\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"#E97768\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 13h18v17l-5 5H15z\"/><path d=\"M28 35v-5h5\"/><path d=\"M15 21h18\"/></svg></span>\n          <span class=\"rs-lb\">Tissu de qualité supérieure</span>\n        </div>\n        <div class=\"rs-feat\">\n          <span class=\"rs-ic\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"#E97768\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 12c5.5 7 8.5 11 8.5 16A8.5 8.5 0 0 1 15.5 28c0-5 3-9 8.5-16z\"/><path d=\"M20 29a4 4 0 0 0 4 4.5\"/></svg></span>\n          <span class=\"rs-lb\">Mousse ultra-absorbante</span>\n        </div>\n        <div class=\"rs-feat\">\n          <span class=\"rs-ic\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"#E97768\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 33 31 17\"/><circle cx=\"32.5\" cy=\"15.5\" r=\"1.7\"/><path d=\"M14.5 33.5l-1.5 3.5 3.5-1.5z\" fill=\"#E97768\"/><path d=\"M29 19c-4 1.5-3.5 6-8.5 8\"/></svg></span>\n          <span class=\"rs-lb\">Cousu main</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"rs-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_25_aout_2026_02_28_19.png?v=1787617783\" alt=\"Booby Trap en salle de sport\" loading=\"lazy\">\n    </div>\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .rs-sec{--green:#A4D867;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--green);padding:64px 20px;}\n  .rs-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}\n  .rs-title{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(28px,3.6vw,42px);color:var(--ink);line-height:1.12;margin:0 0 18px;}\n  .rs-title .a{color:#fff;}\n  .rs-desc{font-family:system-ui,-apple-system,sans-serif;color:#1f2a10;font-size:16px;line-height:1.6;margin:0 0 28px;max-width:520px;}\n  .rs-feats{display:grid;grid-template-columns:1fr 1fr;gap:22px 18px;max-width:520px;}\n  .rs-feat{display:flex;align-items:center;gap:14px;}\n  .rs-ic{flex:0 0 auto;width:52px;height:52px;border-radius:50%;background:#FAEEE6;display:flex;align-items:center;justify-content:center;}\n  .rs-ic svg{width:28px;height:28px;display:block;}\n  .rs-lb{font-family:system-ui,-apple-system,sans-serif;font-weight:600;font-size:14px;color:var(--ink);line-height:1.3;}\n  .rs-media{border:3px solid var(--ink);border-radius:24px;overflow:hidden;box-shadow:0 16px 38px rgba(0,0,0,.18);aspect-ratio:1/1;}\n  .rs-media img{width:100%;height:100%;object-fit:cover;display:block;}\n  @media(max-width:820px){\n    .rs-grid{grid-template-columns:1fr;gap:32px;}\n    .rs-media{order:-1;}\n    .rs-feats{grid-template-columns:1fr;gap:16px;}\n  }\n</style>",
