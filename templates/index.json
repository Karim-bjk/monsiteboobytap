    "custom_liquid_9xz6G7": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"ct-sec\">\n  <div class=\"ct-head\">\n    <h2 class=\"ct-title\">Coupe et taille</h2>\n    <p class=\"ct-sub\">Trouvez la forme qui convient le mieux aux zones où vous transpirez.</p>\n  </div>\n  <div class=\"ct-wrap\">\n    <button class=\"ct-nav ct-prev\" aria-label=\"Précédent\">‹</button>\n    <div class=\"ct-track\" id=\"ctTrack\">\n\n      <div class=\"ct-card\">\n        <div class=\"ct-img\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_38_20.png?v=1787610173\" alt=\"La Quotidienne\" loading=\"lazy\"></div>\n        <h3 class=\"ct-h\">La Quotidienne</h3>\n        <p class=\"ct-dim\">7,6 × 25,4 × 2,5 cm</p>\n        <p class=\"ct-desc\">Conçue pour une couvrance équilibrée, elle cible la transpiration sous et entre les seins tout en réduisant les frottements. La forme idéale au quotidien.</p>\n      </div>\n\n      <div class=\"ct-card\">\n        <div class=\"ct-img\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_46_13.png?v=1787610187\" alt=\"La Couvrante\" loading=\"lazy\"></div>\n        <h3 class=\"ct-h\">La Couvrante</h3>\n        <p class=\"ct-dim\">10,2 × 25,4 × 2,5 cm</p>\n        <p class=\"ct-desc\">Couverture maximale : elle absorbe la transpiration sous la poitrine et au niveau du décolleté, pour les journées les plus intenses.</p>\n      </div>\n\n      <div class=\"ct-card\">\n        <div class=\"ct-img\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_48_34.png?v=1787610199\" alt=\"L'Entre-deux\" loading=\"lazy\"></div>\n        <h3 class=\"ct-h\">L'Entre-deux</h3>\n        <p class=\"ct-dim\">10 × 18 × 2,5 cm</p>\n        <p class=\"ct-desc\">Cible la transpiration entre les seins et réduit les frottements au niveau du décolleté. Parfaite quand la sueur se concentre au centre.</p>\n      </div>\n\n      <div class=\"ct-card\">\n        <div class=\"ct-img\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_50_01.png?v=1787610212\" alt=\"La Sous-Poitrine\" loading=\"lazy\"></div>\n        <h3 class=\"ct-h\">La Sous-Poitrine</h3>\n        <p class=\"ct-dim\">5,1 × 30,5 × 2,5 cm</p>\n        <p class=\"ct-desc\">Absorbe la transpiration sous la poitrine, là où elle s'accumule le plus. Discrète et confortable, elle s'accorde même avec les soutiens-gorge classiques.</p>\n      </div>\n\n      <div class=\"ct-card\">\n        <div class=\"ct-img\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_52_46.png?v=1787610226\" alt=\"La Discrète\" loading=\"lazy\"></div>\n        <h3 class=\"ct-h\">La Discrète</h3>\n        <p class=\"ct-dim\">5,1 × 30,5 × 1,3 cm</p>\n        <p class=\"ct-desc\">Profil ultra-fin pour une discrétion maximale sous un t-shirt. Idéale quand la discrétion prime sur l'absorption.</p>\n      </div>\n\n    </div>\n    <button class=\"ct-nav ct-next\" aria-label=\"Suivant\">›</button>\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .ct-sec{--green:#F0FFDE;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--green);padding:64px 0;overflow:hidden;}\n  .ct-head{text-align:center;padding:0 20px;margin-bottom:34px;}\n  .ct-title{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(28px,4vw,44px);color:var(--ink);margin:0 0 10px;}\n  .ct-sub{font-family:system-ui,-apple-system,sans-serif;color:#4a5a34;font-size:16px;margin:0;}\n  .ct-wrap{position:relative;max-width:1280px;margin:0 auto;}\n  .ct-track{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px max(20px,4vw);scrollbar-width:none;-webkit-overflow-scrolling:touch;}\n  .ct-track::-webkit-scrollbar{display:none;}\n  .ct-card{flex:0 0 320px;scroll-snap-align:center;background:#fff;border:3px solid var(--ink);border-radius:22px;padding:20px;box-sizing:border-box;display:flex;flex-direction:column;}\n  .ct-img{aspect-ratio:1/1;border-radius:14px;overflow:hidden;background:#FAEEE6;margin-bottom:16px;}\n  .ct-img img{width:100%;height:100%;object-fit:cover;display:block;}\n  .ct-h{font-family:'Fraunces',serif;font-weight:900;font-size:22px;color:var(--ink);margin:0 0 4px;}\n  .ct-dim{font-family:system-ui,-apple-system,sans-serif;font-weight:700;font-size:14px;color:#1A1A1A;margin:0 0 12px;}\n  .ct-desc{font-family:system-ui,-apple-system,sans-serif;font-size:14.5px;line-height:1.55;color:#3a4a2a;margin:0;}\n  .ct-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:6;width:46px;height:46px;border-radius:50%;background:#fff;border:2px solid var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:24px;line-height:1;color:var(--ink);font-weight:700;padding-bottom:3px;}\n  .ct-prev{left:6px;} .ct-next{right:6px;}\n  @media(max-width:640px){\n    .ct-card{flex-basis:80%;}\n    .ct-nav{display:none;}\n  }\n</style>\n\n<script>\n(function(){\n  var t=document.getElementById('ctTrack');\n  var p=document.querySelector('.ct-prev'),n=document.querySelector('.ct-next');\n  function gap(){var st=getComputedStyle(t);return parseFloat(st.columnGap||st.gap||22)||22;}\n  function step(){return t.children[0].offsetWidth+gap();}\n  p.addEventListener('click',function(){t.scrollBy({left:-step(),behavior:'smooth'});});\n  n.addEventListener('click',function(){t.scrollBy({left:step(),behavior:'smooth'});});\n})();\n</script>",
