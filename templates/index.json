    "custom_liquid_KjAJH4": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"fs-sec\">\n  <div class=\"fs-head\">\n    <h2 class=\"fs-h2\">Où transpirez-vous le plus&nbsp;?</h2>\n    <p class=\"fs-sub\">Chaque zone a sa forme. Trouvez la vôtre.</p>\n  </div>\n  <div class=\"fs-wrap\">\n    <button class=\"fs-nav fs-prev\" aria-label=\"Précédent\">‹</button>\n    <div class=\"fs-track\" id=\"fsTrack\">\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Quotidienne</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_38_20.png?v=1787610173\" alt=\"La Quotidienne\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Idéale au quotidien pour la transpiration sous et entre les seins.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Couvrante</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_46_13.png?v=1787610187\" alt=\"La Couvrante\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Couverture généreuse pour une absorption maximale sous et entre les seins.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">L'Entre-Deux</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_48_34.png?v=1787610199\" alt=\"L'Entre-Deux\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Cible la transpiration entre les seins et réduit les frottements au décolleté.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Sous-Poitrine</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_50_01.png?v=1787610212\" alt=\"La Sous-Poitrine\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Cible la transpiration sous les seins, pour un confort discret au quotidien.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Discrète</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_52_46.png?v=1787610226\" alt=\"La Discrète\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Profil ultra-fin et discret, idéal quand la discrétion prime sur l'absorption.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n    </div>\n    <button class=\"fs-nav fs-next\" aria-label=\"Suivant\">›</button>\n  </div>\n</div>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .fs-sec{--green:#A4D867;--card:#F0FFDE;--pop:#FFFFFF;--yellow:#FBE986;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--green);padding:72px 0;overflow:hidden;}\n  .fs-head{text-align:center;padding:0 20px;}\n  .fs-h2{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(26px,4vw,38px);color:var(--ink);margin:0 0 8px;}\n  .fs-sub{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(17px,2vw,20px);color:#1A1A1A;margin:0;}\n  .fs-wrap{position:relative;max-width:none;margin:34px auto 0;}\n  .fs-track{display:flex;gap:24px;overflow-x:auto;padding:38px max(24px,4vw);scrollbar-width:none;-webkit-overflow-scrolling:touch;}\n  .fs-track::-webkit-scrollbar{display:none;}\n  .fs-card{flex:0 0 360px;background:var(--card);border:3px solid var(--ink);border-radius:24px;padding:30px 24px 28px;display:flex;flex-direction:column;align-items:center;text-align:center;transition:transform .25s ease, background .25s ease, box-shadow .25s ease;}\n  .fs-card.is-center{background:var(--pop);transform:scale(1.07);box-shadow:0 22px 48px rgba(0,0,0,.20);position:relative;z-index:2;}\n  .fs-title{font-family:'Fraunces',serif;font-weight:900;font-size:27px;color:var(--ink);margin:0 0 18px;}\n  .fs-imgwrap{width:100%;aspect-ratio:1/1;border-radius:16px;overflow:hidden;margin-bottom:18px;background:#fff;}\n  .fs-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;}\n  .fs-desc{font-family:system-ui,-apple-system,sans-serif;color:#555;font-size:15.5px;line-height:1.5;margin:0 0 22px;flex:1;}\n  .fs-btn{font-family:'Fraunces',serif;font-weight:900;font-size:14px;letter-spacing:.03em;text-decoration:none;border:2px solid var(--ink);color:var(--ink);background:var(--yellow);border-radius:999px;padding:14px 24px;transition:.15s;}\n  .fs-btn:hover{background:var(--ink);color:#fff;}\n  .fs-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:6;width:48px;height:48px;border-radius:50%;background:#fff;border:2px solid var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:26px;line-height:1;color:var(--ink);font-weight:700;padding-bottom:3px;}\n  .fs-prev{left:10px;} .fs-next{right:10px;}\n  @media(max-width:640px){\n    .fs-card{flex-basis:78%;padding:24px 18px 22px;}\n    .fs-title{font-size:23px;}\n    .fs-desc{font-size:14px;}\n    .fs-nav{display:none;}\n  }\n</style>\n<script>\n(function(){\n  var track=document.getElementById('fsTrack');\n  var prev=document.querySelector('.fs-prev'), next=document.querySelector('.fs-next');\n  var originals=Array.prototype.slice.call(track.children), n=originals.length;\n  for(var s=0;s<2;s++){ originals.forEach(function(c){ track.appendChild(c.cloneNode(true)); }); }\n  function gap(){ var st=getComputedStyle(track); return parseFloat(st.columnGap||st.gap||24)||24; }\n  function setWidth(){ var f=track.children[0]; return (f.offsetWidth+gap())*n; }\n  track.scrollLeft=setWidth();\n  function wrap(){ var w=setWidth(); if(track.scrollLeft<w*0.5){track.scrollLeft+=w;} else if(track.scrollLeft>w*1.5){track.scrollLeft-=w;} }\n  function center(){\n    var tc=track.scrollLeft+track.clientWidth/2, best=null, bd=1e9;\n    Array.prototype.forEach.call(track.children,function(c){ var cc=c.offsetLeft+c.offsetWidth/2, d=Math.abs(cc-tc); if(d<bd){bd=d;best=c;} });\n    Array.prototype.forEach.call(track.children,function(c){ c.classList.toggle('is-center',c===best); });\n  }\n  var raf;\n  track.addEventListener('scroll',function(){ if(raf)cancelAnimationFrame(raf); raf=requestAnimationFrame(function(){ wrap(); center(); }); });\n  function step(){ return track.children[0].offsetWidth+gap(); }\n  prev.addEventListener('click',function(){ track.scrollBy({left:-step(),behavior:'smooth'}); });\n  next.addEventListener('click',function(){ track.scrollBy({left:step(),behavior:'smooth'}); });\n  window.addEventListener('resize',function(){ setWidth(); });\n  center();\n})();\n</script>",
