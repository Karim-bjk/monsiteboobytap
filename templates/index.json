    "custom_liquid_dXwXfc": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"ba-sec\">\n  <h2>Le résultat parle <span class=\"a\">de lui-même</span></h2>\n  <p>Glissez le curseur : à gauche sans Booby Trap, à droite avec.</p>\n\n  <div class=\"ba\" id=\"ba\">\n    <img class=\"after\" src=\"URL_IMAGE_APRES\" alt=\"Après\" loading=\"lazy\">\n    <div class=\"before\" id=\"baBefore\"><img src=\"URL_IMAGE_AVANT\" alt=\"Avant\" loading=\"lazy\"></div>\n    <div class=\"handle\" id=\"baHandle\"></div>\n    <div class=\"knob\" id=\"baKnob\">⇆</div>\n    <span class=\"lbl l\">Avant</span>\n    <span class=\"lbl r\">Après</span>\n    <input type=\"range\" min=\"0\" max=\"100\" value=\"50\" id=\"baRange\" aria-label=\"Avant / Après\">\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .ba-sec{--green:#F3FFE1;--accent:#AFD776;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--green);padding:56px 20px;text-align:center;}\n  .ba-sec h2{font-family:'Fraunces',serif;font-size:clamp(26px,4vw,38px);font-weight:900;color:var(--ink);margin:0 0 6px;}\n  .ba-sec h2 .a{color:var(--accent);}\n  .ba-sec p{font-family:'Fraunces',serif;font-weight:700;color:#5a5a5a;font-size:17px;max-width:520px;margin:0 auto 28px;line-height:1.5;}\n  .ba{position:relative;max-width:500px;margin:0 auto;border:3px solid var(--ink);border-radius:20px;overflow:hidden;box-shadow:0 14px 34px rgba(0,0,0,.15);aspect-ratio:1/1;user-select:none;}\n  .ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}\n  .ba .before{position:absolute;inset:0;z-index:2;clip-path:inset(0 50% 0 0);}\n  .ba .lbl{position:absolute;top:14px;z-index:4;color:#fff;font-family:'Fraunces',serif;font-weight:900;font-size:14px;padding:6px 14px;border-radius:999px;}\n  .ba .lbl.l{left:14px;background:var(--ink);}\n  .ba .lbl.r{right:14px;background:var(--accent);color:#1A1A1A;}\n  .ba .handle{position:absolute;top:0;bottom:0;left:50%;width:3px;background:#fff;z-index:3;transform:translateX(-50%);pointer-events:none;box-shadow:0 0 6px rgba(0,0,0,.3);}\n  .ba .knob{position:absolute;top:50%;left:50%;z-index:5;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:#fff;border:2px solid var(--ink);pointer-events:none;display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--ink);font-size:18px;}\n  .ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;z-index:6;margin:0;}\n</style>\n\n<script>\n(function(){\n  var r=document.getElementById('baRange'),b=document.getElementById('baBefore'),\n      h=document.getElementById('baHandle'),k=document.getElementById('baKnob');\n  function u(){var v=r.value;b.style.clipPath='inset(0 '+(100-v)+'% 0 0)';h.style.left=v+'%';k.style.left=v+'%';}\n  r.addEventListener('input',u);u();\n})();\n</script>",
