        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"fs-sec\">\n  <div class=\"fs-head\">\n    <h2 class=\"fs-h2\">Où transpirez-vous le plus&nbsp;?</h2>\n    <p class=\"fs-sub\">Chaque zone a sa forme. Trouvez la vôtre.</p>\n  </div>\n\n  <div class=\"fs-wrap\">\n    <button class=\"fs-nav fs-prev\" aria-label=\"Précédent\">‹</button>\n    <div class=\"fs-track\" id=\"fsTrack\">\n\n      <div class=\"fs-card fs-card--feat\">\n        <span class=\"fs-badge\">Best-seller</span>\n        <h3 class=\"fs-title\">La Quotidienne</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_38_20.png?v=1787610173\" alt=\"La Quotidienne\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Idéale au quotidien pour la transpiration sous et entre les seins.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Couvrante</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_46_13.png?v=1787610187\" alt=\"La Couvrante\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Couverture généreuse pour une absorption maximale sous et entre les seins.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">L'Entre-Deux</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_48_34.png?v=1787610199\" alt=\"L'Entre-Deux\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Cible la transpiration entre les seins et réduit les frottements au décolleté.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Sous-Poitrine</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_50_01.png?v=1787610212\" alt=\"La Sous-Poitrine\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Cible la transpiration sous les seins, pour un confort discret au quotidien.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n\n      <div class=\"fs-card\">\n        <h3 class=\"fs-title\">La Discrète</h3>\n        <div class=\"fs-imgwrap\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/ChatGPT_Image_19_aout_2026_21_52_46.png?v=1787610226\" alt=\"La Discrète\" loading=\"lazy\"></div>\n        <p class=\"fs-desc\">Profil ultra-fin et discret, idéal quand la discrétion prime sur l'absorption.</p>\n        <a class=\"fs-btn\" href=\"#\">CHOISISSEZ LA FORME</a>\n      </div>\n\n    </div>\n    <button class=\"fs-nav fs-next\" aria-label=\"Suivant\">›</button>\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .fs-sec{--green:#A4D867;--card:#F0FFDE;--feat:#FAEEE6;--yellow:#FBE986;--ink:#1A1A1A;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);background:var(--green);padding:56px 0;}\n  .fs-head{text-align:center;padding:0 20px;}\n  .fs-h2{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(26px,4vw,38px);color:var(--ink);margin:0 0 6px;}\n  .fs-sub{font-family:'Fraunces',serif;font-weight:700;font-size:17px;color:#3f4a2a;margin:0;}\n  .fs-wrap{position:relative;max-width:1180px;margin:26px auto 0;}\n  .fs-track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 20px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}\n  .fs-track::-webkit-scrollbar{display:none;}\n  .fs-card{position:relative;flex:0 0 258px;scroll-snap-align:center;background:var(--card);border:2px solid rgba(0,0,0,.12);border-radius:20px;padding:24px 18px 22px;display:flex;flex-direction:column;align-items:center;text-align:center;}\n  .fs-card--feat{background:var(--feat);border:3px solid var(--ink);}\n  .fs-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;font-family:'Fraunces',serif;font-weight:900;font-size:11px;letter-spacing:.04em;padding:4px 12px;border-radius:999px;white-space:nowrap;}\n  .fs-title{font-family:'Fraunces',serif;font-weight:900;font-size:22px;color:var(--ink);margin:0 0 14px;}\n  .fs-imgwrap{width:100%;aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:14px;background:#fff;}\n  .fs-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;}\n  .fs-desc{font-family:system-ui,-apple-system,sans-serif;color:#555;font-size:14px;line-height:1.45;margin:0 0 18px;flex:1;}\n  .fs-btn{font-family:'Fraunces',serif;font-weight:900;font-size:13px;letter-spacing:.03em;text-decoration:none;border:2px solid var(--ink);color:var(--ink);background:transparent;border-radius:999px;padding:12px 18px;transition:.15s;}\n  .fs-btn:hover{background:var(--ink);color:#fff;}\n  .fs-card--feat .fs-btn{background:var(--yellow);}\n  .fs-card--feat .fs-btn:hover{background:var(--ink);color:#fff;}\n  .fs-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:44px;height:44px;border-radius:50%;background:#fff;border:2px solid var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:22px;line-height:1;color:var(--ink);font-weight:700;padding-bottom:3px;}\n  .fs-prev{left:2px;} .fs-next{right:2px;}\n  @media(max-width:640px){\n    .fs-card{flex-basis:80%;}\n    .fs-nav{display:none;}\n  }\n</style>\n\n<script>\n(function(){\n  var t=document.getElementById('fsTrack'),\n      p=document.querySelector('.fs-prev'),n=document.querySelector('.fs-next');\n  function step(){return (t.querySelector('.fs-card')?.offsetWidth||280)+18;}\n  p&&p.addEventListener('click',function(){t.scrollBy({left:-step(),behavior:'smooth'});});\n  n&&n.addEventListener('click',function(){t.scrollBy({left:step(),behavior:'smooth'});});\n})();\n</script>",
