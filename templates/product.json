          "settings": {
            "liquid": "{% assign packhandles = \"la-quotidienne,la-couvrante,lentre-deux,la-sous-poitrine,la-discrete\" | split: \",\" %}\n<div class=\"pk-sec\">\n  <div class=\"pk-card\">\n    <h2 class=\"pk-title\">Personnalisez votre pack</h2>\n    <p class=\"pk-sub\">Choisissez 3 formes et couleurs, ou plus — et payez chaque pièce moins cher.</p>\n    <div class=\"pk-slots\" id=\"pkSlots\"></div>\n    <button type=\"button\" class=\"pk-addslot\" id=\"pkAddSlot\">＋ Ajouter une forme</button>\n    <p class=\"pk-hint\" id=\"pkHint\"></p>\n    <div class=\"pk-totrow\"><span>Total du lot :</span><span class=\"pk-tot\" id=\"pkTotal\">—</span></div>\n    <button type=\"button\" class=\"pk-add\" id=\"pkAdd\" disabled>AJOUTER AU PANIER</button>\n    <p class=\"pk-gift\" id=\"pkGift\">🎁 Sac de lavage offert dès 3 articles</p>\n  </div>\n\n  <div class=\"pk-modal\" id=\"pkModal\" hidden>\n    <div class=\"pk-modal-inner\">\n      <button type=\"button\" class=\"pk-close\" id=\"pkClose\" aria-label=\"Fermer\">×</button>\n      <p class=\"pk-modal-title\">Choisissez une forme, puis une couleur</p>\n      <div class=\"pk-tabs\" id=\"pkTabs\"></div>\n      <div class=\"pk-grid\" id=\"pkGrid\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\nwindow.PK_ICONS = {\n  'la-quotidienne':'https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_quotidienne.svg?v=1787878302',\n  'la-couvrante':'https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_couvrante.svg?v=1787878302',\n  'lentre-deux':'https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_l_entre_deux.svg?v=1787878302',\n  'la-sous-poitrine':'https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_sous_poitrine_et_la_discrete.svg?v=1787878302',\n  'la-discrete':'https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_sous_poitrine_et_la_discrete.svg?v=1787878302'\n};\nwindow.PK_PRODUCTS = [\n{% for h in packhandles %}{% assign p = all_products[h] %}{% if p %}\n  {\n    handle: {{ p.handle | json }},\n    title: {{ p.title | json }},\n    variants: [\n      {% for v in p.variants %}{% assign vimg = v.image | default: p.featured_image %}{ id: {{ v.id }}, color: {{ v.title | json }}, img: {{ vimg | image_url: width: 300 | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}\n    ]\n  }{% unless forloop.last %},{% endunless %}\n{% endif %}{% endfor %}\n];\n</script>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .pk-sec{--green:#A4D867;--card:#F0FFDE;--cream:#FAEEE6;--yellow:#FBE986;--pink:#E97768;--ink:#1A1A1A;font-family:system-ui,-apple-system,sans-serif;max-width:640px;margin:24px auto;padding:0 16px;}\n  .pk-card{background:var(--card);border:3px solid var(--ink);border-radius:24px;padding:28px 24px 26px;text-align:center;}\n  .pk-title{font-family:'Fraunces',serif;font-weight:900;font-size:clamp(24px,4vw,30px);color:var(--ink);margin:0 0 6px;}\n  .pk-sub{font-size:15px;color:#4a4a4a;margin:0 0 22px;}\n  .pk-slots{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}\n  .pk-slot{position:relative;aspect-ratio:1/1;border:2px dashed #b9c6a0;border-radius:16px;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;transition:.15s;}\n  .pk-slot:hover{border-color:var(--ink);}\n  .pk-slot.filled{border-style:solid;border-color:var(--ink);cursor:default;}\n  .pk-slot .pk-plus{font-size:30px;color:#9aa886;font-weight:400;}\n  .pk-slot img{width:100%;height:100%;object-fit:cover;display:block;}\n  .pk-slot .pk-remove{position:absolute;top:6px;right:6px;width:24px;height:24px;border-radius:50%;background:var(--pink);color:#fff;border:none;font-size:15px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;}\n  .pk-slot .pk-cname{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.55);color:#fff;font-size:11px;padding:3px;font-weight:700;}\n  .pk-addslot{margin:14px 0 0;background:none;border:none;color:#3f4a2a;font-weight:800;font-size:14px;cursor:pointer;text-decoration:underline;}\n  .pk-hint{font-size:14px;color:var(--ink);font-weight:700;margin:16px 0 10px;min-height:20px;}\n  .pk-totrow{display:flex;justify-content:space-between;align-items:baseline;font-family:'Fraunces',serif;font-weight:900;font-size:20px;color:var(--ink);border-top:2px solid rgba(0,0,0,.12);padding-top:16px;margin-top:6px;}\n  .pk-tot .old{font-family:system-ui,sans-serif;font-weight:600;font-size:15px;color:#999;text-decoration:line-through;margin-right:8px;}\n  .pk-add{width:100%;margin-top:16px;background:var(--ink);color:#fff;border:none;border-radius:999px;padding:17px;font-family:'Fraunces',serif;font-weight:900;font-size:16px;letter-spacing:.02em;cursor:pointer;transition:.15s;}\n  .pk-add:disabled{background:#c3c3c3;cursor:not-allowed;}\n  .pk-add:not(:disabled):hover{background:var(--pink);}\n  .pk-gift{font-size:13px;color:#4a4a4a;margin:12px 0 0;}\n  .pk-modal{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:flex-end;justify-content:center;padding:0;}\n  .pk-modal[hidden]{display:none;}\n  .pk-modal-inner{background:var(--card);border:3px solid var(--ink);border-radius:24px 24px 0 0;width:100%;max-width:680px;max-height:82vh;overflow-y:auto;padding:26px 20px 30px;position:relative;}\n  @media(min-width:700px){.pk-modal{align-items:center;}.pk-modal-inner{border-radius:24px;}}\n  .pk-close{position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;background:#fff;border:2px solid var(--ink);font-size:20px;line-height:1;cursor:pointer;}\n  .pk-modal-title{font-family:'Fraunces',serif;font-weight:900;font-size:18px;color:var(--ink);margin:0 0 16px;padding-right:40px;}\n  .pk-tabs{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:16px;scrollbar-width:none;}\n  .pk-tabs::-webkit-scrollbar{display:none;}\n  .pk-tab{display:flex;align-items:center;gap:7px;white-space:nowrap;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:8px 14px 8px 10px;font-family:'Fraunces',serif;font-weight:900;font-size:13px;color:var(--ink);cursor:pointer;}\n  .pk-tab img{height:22px;width:auto;display:block;}\n  .pk-tab.on{background:var(--green);}\n  .pk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}\n  .pk-swatch{border:2px solid var(--ink);border-radius:16px;background:#fff;padding:8px;cursor:pointer;text-align:center;transition:.15s;}\n  .pk-swatch:hover{background:var(--cream);}\n  .pk-swatch img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px;display:block;margin-bottom:6px;}\n  .pk-swatch span{font-size:12px;font-weight:700;color:var(--ink);}\n  @media(max-width:420px){.pk-grid{grid-template-columns:repeat(2,1fr);}}\n</style>\n\n<script>\n(function(){\n  var UNIT=2490, T3=1990, T6=1490, MIN=3, NEXT=6, MAXSLOTS=12;\n  var P=window.PK_PRODUCTS||[], ICONS=window.PK_ICONS||{};\n  var slots=[null,null,null], editing=-1, activeShape=0;\n  var elSlots=document.getElementById('pkSlots'), elHint=document.getElementById('pkHint'),\n      elTotal=document.getElementById('pkTotal'), elAdd=document.getElementById('pkAdd'),\n      elModal=document.getElementById('pkModal'), elTabs=document.getElementById('pkTabs'),\n      elGrid=document.getElementById('pkGrid');\n  function money(c){return (c/100).toFixed(2).replace('.',',')+' €';}\n  function count(){return slots.filter(Boolean).length;}\n  function perUnit(n){ if(n>=T6cnt) return T6; if(n>=MIN) return T3; return UNIT; }\n  var T6cnt=NEXT;\n\n  function renderSlots(){\n    elSlots.innerHTML='';\n    slots.forEach(function(s,i){\n      var d=document.createElement('div'); d.className='pk-slot'+(s?' filled':'');\n      if(s){\n        d.innerHTML='<button class=\"pk-remove\" data-i=\"'+i+'\" aria-label=\"Retirer\">×</button><img src=\"'+s.img+'\" alt=\"\"><span class=\"pk-cname\">'+s.shape+' · '+s.color+'</span>';\n      }else{\n        d.innerHTML='<span class=\"pk-plus\">＋</span>'; d.addEventListener('click',function(){openPicker(i);});\n      }\n      elSlots.appendChild(d);\n    });\n    Array.prototype.forEach.call(elSlots.querySelectorAll('.pk-remove'),function(b){\n      b.addEventListener('click',function(e){e.stopPropagation();slots[+b.dataset.i]=null;renderSlots();});\n    });\n    summary();\n  }\n  function summary(){\n    var n=count(), per=perUnit(n), tot=n*per;\n    if(n===0){elTotal.textContent='—';}\n    else if(n>=MIN){elTotal.innerHTML='<span class=\"old\">'+money(n*UNIT)+'</span>'+money(tot);}\n    else{elTotal.textContent=money(tot);}\n    if(n===0){elHint.textContent='Choisissez au moins 3 formes pour le tarif pack.';}\n    else if(n<MIN){elHint.textContent='Ajoutez '+(MIN-n)+' forme'+((MIN-n)>1?'s':'')+' pour débloquer 19,90 € la pièce + le sac offert.';}\n    else if(n<NEXT){elHint.textContent='🎉 19,90 € la pièce + sac offert ! Ajoutez '+(NEXT-n)+' forme'+((NEXT-n)>1?'s':'')+' pour passer à 14,90 € la pièce.';}\n    else{elHint.textContent='🎉 Meilleur tarif débloqué : 14,90 € la pièce + sac de lavage offert !';}\n    elAdd.disabled = n<MIN;\n  }\n  document.getElementById('pkAddSlot').addEventListener('click',function(){\n    if(slots.length<MAXSLOTS){slots.push(null);renderSlots();}\n  });\n\n  function openPicker(i){editing=i;renderTabs();renderGrid();elModal.hidden=false;document.body.style.overflow='hidden';}\n  function closePicker(){elModal.hidden=true;document.body.style.overflow='';}\n  document.getElementById('pkClose').addEventListener('click',closePicker);\n  elModal.addEventListener('click',function(e){if(e.target===elModal)closePicker();});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!elModal.hidden)closePicker();});\n\n  function renderTabs(){\n    elTabs.innerHTML='';\n    P.forEach(function(p,idx){\n      var t=document.createElement('button'); t.className='pk-tab'+(idx===activeShape?' on':'');\n      var ic=ICONS[p.handle]?'<img src=\"'+ICONS[p.handle]+'\" alt=\"\">':'';\n      t.innerHTML=ic+'<span>'+p.title+'</span>';\n      t.addEventListener('click',function(){activeShape=idx;renderTabs();renderGrid();});\n      elTabs.appendChild(t);\n    });\n  }\n  function renderGrid(){\n    elGrid.innerHTML='';\n    var p=P[activeShape]; if(!p)return;\n    p.variants.forEach(function(v){\n      var c=document.createElement('div'); c.className='pk-swatch';\n      c.innerHTML='<img src=\"'+v.img+'\" alt=\"\"><span>'+v.color+'</span>';\n      c.addEventListener('click',function(){\n        slots[editing]={id:v.id,img:v.img,color:v.color,shape:p.title};\n        closePicker();renderSlots();\n      });\n      elGrid.appendChild(c);\n    });\n  }\n\n  elAdd.addEventListener('click',function(){\n    var items=slots.filter(Boolean).map(function(s){return {id:s.id,quantity:1};});\n    if(items.length<MIN)return;\n    elAdd.disabled=true; elAdd.textContent='Ajout en cours…';\n    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})\n      .then(function(r){return r.json();})\n      .then(function(){window.location.href='/cart';})\n      .catch(function(){elAdd.disabled=false;elAdd.textContent='AJOUTER AU PANIER';alert('Un souci est survenu, réessaie.');});\n  });\n\n  renderSlots();\n})();\n</script>"
