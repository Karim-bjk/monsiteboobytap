            "liquid": "<div class=\"shp-sec\">\n  <p class=\"shp-head\">Choisissez votre forme <span>— {{ product.title }}</span></p>\n  <div class=\"shp-grid\">\n\n    <a class=\"shp-pill{% if product.handle == 'la-quotidienne' %} is-active{% endif %}\" href=\"/products/la-quotidienne\">\n      <span class=\"shp-ico\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_quotidienne.svg?v=1787878302\" alt=\"La Quotidienne\"></span>\n      <span class=\"shp-name\">La Quotidienne</span>\n    </a>\n\n    <a class=\"shp-pill{% if product.handle == 'la-couvrante' %} is-active{% endif %}\" href=\"/products/la-couvrante\">\n      <span class=\"shp-ico\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_couvrante.svg?v=1787878302\" alt=\"La Couvrante\"></span>\n      <span class=\"shp-name\">La Couvrante</span>\n    </a>\n\n    <a class=\"shp-pill{% if product.handle == 'lentre-deux' %} is-active{% endif %}\" href=\"/products/lentre-deux\">\n      <span class=\"shp-ico\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_l_entre_deux.svg?v=1787878302\" alt=\"L'Entre-Deux\"></span>\n      <span class=\"shp-name\">L'Entre-Deux</span>\n    </a>\n\n    <a class=\"shp-pill{% if product.handle == 'la-sous-poitrine' %} is-active{% endif %}\" href=\"/products/la-sous-poitrine\">\n      <span class=\"shp-ico\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_sous_poitrine_et_la_discrete.svg?v=1787878302\" alt=\"La Sous-Poitrine\"></span>\n      <span class=\"shp-name\">La Sous-Poitrine</span>\n    </a>\n\n    <a class=\"shp-pill{% if product.handle == 'la-discrete' %} is-active{% endif %}\" href=\"/products/la-discrete\">\n      <span class=\"shp-ico\"><img src=\"https://cdn.shopify.com/s/files/1/1035/0870/5615/files/icone_la_sous_poitrine_et_la_discrete.svg?v=1787878302\" alt=\"La Discrète\"></span>\n      <span class=\"shp-name\">La Discrète</span>\n    </a>\n\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap');\n  .shp-sec{--green:#A4D867;--ink:#1A1A1A;--fill:#F0FFDE;margin:22px 0;}\n  .shp-head{font-family:'Fraunces',serif;font-weight:900;font-size:16px;color:var(--ink);margin:0 0 12px;}\n  .shp-head span{font-weight:700;color:#6b6b6b;}\n  .shp-grid{display:flex;flex-wrap:wrap;gap:10px;}\n  .shp-pill{display:flex;align-items:center;gap:10px;text-decoration:none;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:9px 18px 9px 12px;transition:.15s;}\n  .shp-pill:hover{background:var(--fill);}\n  .shp-pill.is-active{background:var(--green);}\n  .shp-ico{display:flex;flex:0 0 auto;}\n  .shp-ico img{height:30px;width:auto;display:block;}\n  .shp-name{font-family:'Fraunces',serif;font-weight:900;font-size:15px;color:var(--ink);line-height:1;}\n</style>"
